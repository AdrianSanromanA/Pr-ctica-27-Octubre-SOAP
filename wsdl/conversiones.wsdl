<?xml version="1.0" encoding="UTF-8"?>
<definitions name="ConversionesService"
             targetNamespace="http://www.examples.com/wsdl/ConversionesService.wsdl"
             xmlns="http://schemas.xmlsoap.org/wsdl/"
             xmlns:tns="http://www.examples.com/wsdl/ConversionesService.wsdl"
             xmlns:xsd="http://www.w3.org/2001/XMLSchema"
             xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/">

    <types>
        <xsd:schema targetNamespace="http://www.examples.com/wsdl/ConversionesService.wsdl">
            <xsd:element name="CelsiusAFahrenheitRequest">
                <xsd:complexType><xsd:sequence><xsd:element name="celsius" type="xsd:double"/></xsd:sequence></xsd:complexType>
            </xsd:element>
            <xsd:element name="CelsiusAFahrenheitResponse">
                <xsd:complexType><xsd:sequence><xsd:element name="resultado" type="xsd:double"/></xsd:sequence></xsd:complexType>
            </xsd:element>
            <xsd:element name="KilometrosAMillasRequest">
                <xsd:complexType><xsd:sequence><xsd:element name="kilometros" type="xsd:double"/></xsd:sequence></xsd:complexType>
            </xsd:element>
            <xsd:element name="KilometrosAMillasResponse">
                <xsd:complexType><xsd:sequence><xsd:element name="resultado" type="xsd:double"/></xsd:sequence></xsd:complexType>
            </xsd:element>
        </xsd:schema>
    </types>

    <message name="CelsiusAFahrenheitInput"><part name="parameters" element="tns:CelsiusAFahrenheitRequest"/></message>
    <message name="CelsiusAFahrenheitOutput"><part name="parameters" element="tns:CelsiusAFahrenheitResponse"/></message>
    <message name="KilometrosAMillasInput"><part name="parameters" element="tns:KilometrosAMillasRequest"/></message>
    <message name="KilometrosAMillasOutput"><part name="parameters" element="tns:KilometrosAMillasResponse"/></message>

    <portType name="ConversionesPortType">
        <operation name="CelsiusAFahrenheit">
            <input message="tns:CelsiusAFahrenheitInput"/>
            <output message="tns:CelsiusAFahrenheitOutput"/>
        </operation>
        <operation name="KilometrosAMillas">
            <input message="tns:KilometrosAMillasInput"/>
            <output message="tns:KilometrosAMillasOutput"/>
        </operation>
    </portType>

    <binding name="ConversionesBinding" type="tns:ConversionesPortType">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <operation name="CelsiusAFahrenheit">
            <soap:operation soapAction="CelsiusAFahrenheit"/>
            <input><soap:body use="literal"/></input>
            <output><soap:body use="literal"/></output>
        </operation>
        <operation name="KilometrosAMillas">
            <soap:operation soapAction="KilometrosAMillas"/>
            <input><soap:body use="literal"/></input>
            <output><soap:body use="literal"/></output>
        </operation>
    </binding>

    <service name="ConversionesService">
        <port name="ConversionesPort" binding="tns:ConversionesBinding">
            <soap:address location="http://localhost:3000/soap/conversiones"/>
        </port>
    </service>
</definitions>